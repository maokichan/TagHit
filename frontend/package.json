{
  "name": "taghit",
  "description": "TagHit — 多源内容标记与管理系统（Electron 重构版）",
  "author": "TagHit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:templates": "node scripts/check-templates.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:strict": "node scripts/check-i18n.mjs --strict",
    "check:style": "node scripts/check-style.mjs",
    "style": "vite --config vite.renderer.config.ts --port 5174 --open /style.html",
    "check:build": "vite build --config vite.renderer.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "vue-i18n": "^11.4.18"
  }
}
