{
  "name": "taghit",
  "version": "0.2.0-dev",
  "description": "TagHit — 多源内容标记与管理系统",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck:domain": "tsc -p tsconfig.domain.json",
