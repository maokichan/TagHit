{
  "id": "audioPlayer",
  "title": { "zh": "音频播放器", "en": "Audio Player" },
  "description": "认领音频条目：黑胶播放、歌词同步、封面提取的第一消费方。",
  "version": "0.3.0",
  "author": "TagHit",
  "apiVersion": "0.2.4",
  "mounts": ["contentTab"],
  "surfaces": ["toast"],
  "settings": [
    {
      "key": "lyricsFontSize",
      "type": "enum",
      "label": "歌词字号",
      "options": [
        { "value": "standard", "label": "标准" },
        { "value": "large", "label": "大" }
      ],
      "default": "standard"
    }
  ]
}
