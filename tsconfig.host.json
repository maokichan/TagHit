{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/ports/**/*.ts",
    "src/adapters/**/*.ts",
    "src/application/**/*.ts",
    "src/host/**/*.ts"
  ]
}
